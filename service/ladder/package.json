{
  "name": "quasimorph-dive-ladder",
  "version": "1.0.0",
  "private": true,
  "description": "Daily leaderboard service for The Dive (Quasimorph RoguelikeMode mod)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "schema:local": "wrangler d1 execute dive-ladder --local --file=./schema.sql",
    "schema:remote": "wrangler d1 execute dive-ladder --remote --file=./schema.sql",
    "test": "node test/ladder.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
